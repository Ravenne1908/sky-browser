# Pinned upstream source for Sky Browser builds.
# This is the single source of truth for "which Firefox are we based on".
# Re-basing = bump the tag, re-run setup.sh in a fresh .build/, re-apply patches.
#
# Tags follow Mozilla's convention:
#   ESR:      FIREFOX_<major>_<minor>_<point>esr_RELEASE
#   Regular:  FIREFOX_<major>_<minor>[_<point>]_RELEASE
# Check the latest ESR at: https://www.mozilla.org/en-US/firefox/all/#product-desktop-esr
UPSTREAM_REPO=https://github.com/mozilla-firefox/firefox
UPSTREAM_TAG=FIREFOX_153_8_0esr_RELEASE
UPSTREAM_DISPLAY_VERSION=153.8.0esr
